              <Button id="btn_setLocation" taborder="0" text="다른 지역 선택" left="37.99%" top="130" width="10.00%" height="50" onclick="Div00_btn_selLocation_onclick" cssclass="btn_WF_basic02" background="#6bb5c0" color="white"/>
              <Button id="btn_setCurLocation" taborder="1" text="기본 값으로 설정" left="51.94%" top="130" width="10.00%" height="50" onclick="Div00_btn_setCurLocation_onclick" cssclass="btn_WF_basic02" background="#5e87e9" color="white"/>
              <Static id="staCenter" taborder="3" text="Static00" left="0" top="0" width="50%" height="50%" visible="false"/>
              <Static id="staLocation" taborder="2" text="당신을 위한&#13;&#10;서울 강남구 삼성동 맛집" left="staCenter:-24.02%" top="17" width="23.96%" height="82" textAlign="center" font="bold 14pt/normal &quot;Sans Serif Collection&quot;" verticalAlign="bottom" color="white"/>
            </Layout>
          </Layouts>
        </Div>
