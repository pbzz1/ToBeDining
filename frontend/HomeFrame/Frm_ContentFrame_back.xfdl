        <ColumnInfo>
          <Column id="TAG_ID" type="STRING" size="256"/>
          <Column id="STORE_ID" type="STRING" size="256"/>
          <Column id="STORE_NAME" type="STRING" size="256"/>
          <Column id="STORE_PHOTO" type="STRING" size="256"/>
          <Column id="STORE_COUNT" type="STRING" size="256"/>
          <Column id="TAG_NAME" type="STRING" size="256"/>
          <Column id="STORE_ADDR_MAIN" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="dsFilterAddr">
        <ColumnInfo>
          <Column id="TAG_ID" type="STRING" size="256"/>
          <Column id="STORE_ID" type="STRING" size="256"/>
          <Column id="STORE_NAME" type="STRING" size="256"/>
          <Column id="STORE_PHOTO" type="STRING" size="256"/>
          <Column id="TAG_NAME" type="STRING" size="256"/>
          <Column id="TAG_COUNT" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="dsFilterTag">
        <ColumnInfo>
          <Column id="TAG_ID" type="STRING" size="256"/>
          <Column id="STORE_ID" type="STRING" size="256"/>
          <Column id="STORE_NAME" type="STRING" size="256"/>
          <Column id="STORE_PHOTO" type="STRING" size="256"/>
          <Column id="TAG_NAME" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
  </Form>
</FDL>
