<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Frm_ContentFrame" width="1440" height="730" titletext="ContentFrame" onload="Frm_ContentFrame_onload" scrollbartype="none none" accessibilitydesclevel="child">
    <Layouts>
      <Layout height="730" width="1440" stepcount="2">
        <Div id="Div00" taborder="0" text="Div00" top="0" width="100.00%" height="200" left="0" background="aliceblue">
          <Layouts>
            <Layout>
              <Button id="btn_setLocation" taborder="0" text="다른 지역 선택" left="38.00%" top="113" width="144" height="67" onclick="Div00_btn_selLocation_onclick" cssclass="btn_WF_basic02"/>
              <Button id="btn_setCurLocation" taborder="1" text="기본 값으로 설정" left="52.00%" top="113" width="144" height="67" onclick="Div00_btn_setCurLocation_onclick" cssclass="btn_WF_basic02"/>
              <Static id="staLocation" taborder="2" text="당신을 위한&#13;&#10;서울 강남구 삼성동 맛집" left="37.99%" top="17" width="345" height="82" textAlign="center"/>
            </Layout>
          </Layouts>
        </Div>
        <WebBrowser id="webPost" taborder="1" left="13" top="8" width="335" height="264" onusernotify="webPost_onusernotify" visible="false"/>
        <Div id="div_main_product" taborder="2" text="Div01" left="143" top="230" width="1152" height="2570" background="aliceblue" formscrollbartype="none none" formscrolltype="none" enableevent="false">
          <Layouts>
            <Layout/>
          </Layouts>
        </Div>
        <Grid id="Grid00" taborder="3" left="72" top="68" width="1250" height="242" positionstep="1" binddataset="dsFilterAddr" autofittype="col">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
              </Columns>
              <Rows>
                <Row band="head" size="24"/>
                <Row size="24"/>
              </Rows>
              <Band id="head">
                <Cell text="TAG_ID"/>
                <Cell col="1" text="STORE_ID"/>
                <Cell col="2" text="STORE_NAME"/>
                <Cell col="3" text="STORE_PHOTO"/>
                <Cell col="4" text="TAG_NAME"/>
              </Band>
              <Band id="body">
                <Cell text="bind:TAG_ID"/>
                <Cell col="1" text="bind:STORE_ID"/>
                <Cell col="2" text="bind:STORE_NAME"/>
                <Cell col="3" text="bind:STORE_PHOTO"/>
                <Cell col="4" text="bind:TAG_NAME"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Grid id="Grid01" taborder="4" left="76" top="360" width="1264" height="210" positionstep="1" binddataset="dsFilterTag" autofittype="col">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
              </Columns>
              <Rows>
                <Row band="head" size="24"/>
                <Row size="24"/>
              </Rows>
              <Band id="head">
                <Cell text="TAG_ID"/>
                <Cell col="1" text="STORE_ID"/>
                <Cell col="2" text="STORE_NAME"/>
                <Cell col="3" text="STORE_PHOTO"/>
                <Cell col="4" text="TAG_NAME"/>
              </Band>
              <Band id="body">
                <Cell text="bind:TAG_ID"/>
                <Cell col="1" text="bind:STORE_ID"/>
                <Cell col="2" text="bind:STORE_NAME"/>
                <Cell col="3" text="bind:STORE_PHOTO"/>
                <Cell col="4" text="bind:TAG_NAME"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Grid id="Grid02" taborder="5" left="32" top="99" width="278" height="294" binddataset="dsFilterAddr">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
              </Columns>
              <Rows>
                <Row band="head" size="24"/>
                <Row size="24"/>
              </Rows>
              <Band id="head">
                <Cell text="TAG_ID"/>
                <Cell col="1" text="STORE_ID"/>
                <Cell col="2" text="STORE_NAME"/>
                <Cell col="3" text="STORE_PHOTO"/>
                <Cell col="4" text="TAG_NAME"/>
                <Cell col="5" text="TAG_COUNT"/>
              </Band>
              <Band id="body">
                <Cell text="bind:TAG_ID"/>
                <Cell col="1" text="bind:STORE_ID"/>
                <Cell col="2" text="bind:STORE_NAME"/>
                <Cell col="3" text="bind:STORE_PHOTO"/>
                <Cell col="4" text="bind:TAG_NAME"/>
                <Cell col="5" text="bind:TAG_COUNT"/>
              </Band>
