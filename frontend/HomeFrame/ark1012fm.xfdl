<FDL version="2.1">
  <Form id="ark1012fm" width="750" height="205" titletext="홈배너" onload="ark1012fm_onload" ontimer="ark1012fm_ontimer" background="#d6edbe">
    <Layouts>
      <Layout height="205" width="750" stepcount="14">
        <Static id="staCenter" taborder="0" left="0" top="0" width="50%" height="50%" visible="false" positionstep="-1"/>
        <ImageViewer id="ImageViewer00" taborder="1" left="0" top="0" width="750" positionstep="-1" bottom="0"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[/**
*	개발 표준화 작업
*	@MenuPath C:\EduPack\workspace\edupack_egov\src\main\ToBeDining\HomeFrame
*	@FileName ark1012fm.xfdl
