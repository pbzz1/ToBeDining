*	
*
*/
/**************************************************************************
* include 영역
**************************************************************************/

/**************************************************************************
* FORM 변수 선언 영역 (fv)
**************************************************************************/
this.fvStep = 0;
this.elapseTime = 2000;
var objApp = nexacro.getApplication();
var sBannerImagePath = objApp.sMyImagePath + "homeBanner/"; //C:/EduPack/workspace/.metadata/.plugins/org.eclipse.wst.server.core/tmp0/wtpwebapps/edupack_egov/upload_file/nexa_edu/homeBanner/
/**************************************************************************
* FORM EVENT 영역(onload, onbeforeclose)
**************************************************************************/
this.ark1012fm_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	this.stepselector.set_visible(false);
	this.set_stepshowtype("action");
	
	this.setTimer(0, this.elapseTime);	
	//this.sHomeBannerURL ="http://172.10.14.134:8088/edupack_egov/upload_file/nexa_edu/homeBanner/banner0.jpg"
	var sImageName = sBannerImagePath + "banner0.jpg";
	this.sHomeBannerURL ="URL('file://"+sImageName+"')"
	trace(this.sHomeBannerURL);
	this.ImageViewer00.set_image(this.sHomeBannerURL);
	//trace("b");
};
this.ark1012fm_ontimer = function(obj:nexacro.Form,e:nexacro.TimerEventInfo)
{
	//trace("a");
	//trace("e.timerid->>"+e.timerid);
	if (e.timerid == 0)
	{
		if (this.fvStep == this.getStepCount()) {
			this.fvStep = 0;
			//this.sHomeBannerURL ="URL(file://C:/EduPack/workspace/.metadata/.plugins/org.eclipse.wst.server.core/tmp0/wtpwebapps/edupack_egov/upload_file/nexa_edu/homeBanner/banner0.jpg)"
			//this.imgHomebanner.set_image("URL('"+this.sHomeBannerURL+"')");
			this.ImageViewer00.set_image(this.sHomeBannerURL);
	
		}
		else {
			this.stepselector.set_stepindex(++this.fvStep);
			var sImageName = sBannerImagePath + "/Mybanner"+this.fvStep+".jpg";
			this.sHomeBannerURL ="URL('file://"+sImageName+"')"
			//this.sHomeBannerURL ="URL(file://C:/EduPack/workspace/.metadata/.plugins/org.eclipse.wst.server.core/tmp0/wtpwebapps/edupack_egov/upload_file/nexa_edu/homeBanner/Mybanner"+this.fvStep+".jpg)";
			this.ImageViewer00.set_image(this.sHomeBannerURL);
		}
	} 

};
