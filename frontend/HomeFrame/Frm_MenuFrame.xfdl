<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Frm_MenuFrame" width="1440" height="60" titletext="MenuFrame" onload="Frm_MenuFrame_onload">
    <Layouts>
      <Layout height="60" width="1440">
        <Div id="divMenu" taborder="0" left="36" top="0" width="95%" height="100.00%" borderRadius="20px" formscrollbartype="none none" background="#f0f0f0">
          <Layouts>
            <Layout/>
          </Layouts>
        </Div>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[/**
