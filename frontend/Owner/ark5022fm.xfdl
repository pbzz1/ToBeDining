    <Bind>
      <BindItem id="item2" compid="calReserve" propid="value" datasetid="dsReserve" columnid="RESERVE_DATE"/>
      <BindItem id="item3" compid="edtReserveNum" propid="value" datasetid="dsReserve" columnid="RESERVE_NUM"/>
    </Bind>
    <Script type="xscript5.1"><![CDATA[/**
*	개발 표준화 작업
*	@MenuPath C:\EduPack\workspace\edupack_egov\src\main\ToBeDining\Owner
*	@FileName ark5022fm.xfdl
*	@Creator 김태훈
*	@CreateDate 2025/02/17
*	@Desction 해당 폼 정보 설명
******************소스 수정 이력**********************************************
*	date		Modifier	Description
********************************************************************************
*	2025/02/17		김태훈		최초 생성
*	
*
*/
/**************************************************************************
* include 영역
**************************************************************************/

/**************************************************************************
* FORM 변수 선언 영역 (fv)
**************************************************************************/

/**************************************************************************
* FORM EVENT 영역(onload, onbeforeclose)
**************************************************************************/

/**************************************************************************
* CRUD 및 TRANSACTION 서비스 호출 처리
**************************************************************************/

/**************************************************************************
* CALLBACK 콜백 처리부분(Transaction, Popup)
**************************************************************************/

/**************************************************************************
* 사용자 FUNCTION 영역
**************************************************************************/

/**************************************************************************
* 각 COMPONENT 별 EVENT 영역
**************************************************************************/

this.btnReserveClose_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var arrRtn = [];
	arrRtn[0] = this.edtReserveNum.value;
	arrRtn[1] = this.cmbReserveHour.value + " : " + this.cmbReserveMin.value;
	arrRtn[2] = this.calReserve.value;
	
	this.parent.parent.popupCalender.closePopup(arrRtn);
};

this.Button_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	if(this.edtReserveNum.text == "0"){
		this.edtReserveNum.value = 0;
	}
	var CurVal = this.edtReserveNum.value;
	if(CurVal > 0){
		if(obj.id == "btnReserveNumMinus"){
			this.edtReserveNum.set_value(parseInt(CurVal) - 1);
		}else{
			this.edtReserveNum.set_value(parseInt(CurVal) + 1);
		}
	}else if(CurVal == 0){
		if(obj.id == "btnReserveNumPlus"){
			this.edtReserveNum.set_value(parseInt(CurVal) + 1);
		}
	}
};


this.ark5022fm_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	this.edtReserveNum.set_text("0");
};
]]></Script>
  </Form>
</FDL>
