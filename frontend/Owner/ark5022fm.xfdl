<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="ark5022fm" width="290" height="470" titletext="예약 팝업 div" onload="ark5022fm_onload">
    <Layouts>
      <Layout height="470" width="290">
        <Calendar id="calReserve" taborder="0" left="0" top="0" height="308" type="monthonly" width="100%" border="0px none, 0px none, 1px none #f0f0f0" onchanged="calReserve_onchanged" usetrailingday="true" usecontextmenu="false" popuptype="none" weekformat="                                                                                        "/>
        <Static id="staReserveNum" taborder="1" text="인원수" left="12" top="calReserve:13" width="45" height="30" font="bold 11pt/normal &quot;Sans Serif Collection&quot;" verticalAlign="top"/>
        <Static id="staReserveTime" taborder="2" text="예약시간" left="12" top="calReserve:60" width="60" height="30" font="bold 11pt/normal &quot;Sans Serif Collection&quot;" verticalAlign="top"/>
        <Button id="btnReserveNumMinus" taborder="3" text="-" left="staReserveNum:15" top="calReserve:18" width="30" height="30" background="#f93a00" borderRadius="20px" color="white" onclick="Button_onclick"/>
        <Edit id="edtReserveNum" taborder="4" left="btnReserveNumMinus:4" top="calReserve:18" width="51" height="30" value="0" text="0" displaynulltext="0"/>
        <Button id="btnReserveNumPlus" taborder="5" text="+" left="edtReserveNum:4" top="calReserve:18" width="30" height="30" background="#f93a00" borderRadius="20px" color="white" onclick="Button_onclick"/>
        <Combo id="cmbReserveHour" taborder="6" text="00" left="staReserveTime:15" top="calReserve:63" width="56" height="25" value="00" index="23" innerdataset="innerdataset" codecolumn="codecolumn" datacolumn="datacolumn">
