        <Combo id="cmbReserveMin" taborder="8" text="00" left="Static00:5" top="calReserve:63" width="56" height="25" value="00" index="0" innerdataset="innerdataset" codecolumn="codecolumn" datacolumn="datacolumn">
          <Dataset id="innerdataset">
