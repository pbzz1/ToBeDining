    <Script type="xscript5.1"><![CDATA[/**************************************************************************
* FORM 변수 선언 영역
**************************************************************************/
var objApp = nexacro.getApplication();
var sReviewSum = 0;

// ★ 웹 이미지 경로 (반드시 HTTP 사용)
// - 운영/개발 환경 바뀌면 여기만 바꾸면 됨
var sImageHttpPath = "http://localhost:8088/edupack_egov/upload_file/nexa_edu/";

/**************************************************************************
* 공통: 이미지 URL 정규화 함수
* - DB/서버에서 내려오는 값이
*   1) null/""/undefined
*   2) "undefined"
*   3) "URL('http://...')" 또는 "URL('file://...')"
*   4) "http://..."
*   5) "user_profile_1.png" 같은 파일명
*   6) "profile_image/user_profile_1.png" 같은 상대경로
*   7) "C:\..." 같은 로컬경로
*   등 어떤 형태든 안전하게 처리
**************************************************************************/
this.fnNormalizeImageUrl = function(raw, folder, defaultFile)
{
    // folder 예: "profile_image/", "store_photo/"
    // defaultFile 예: "undefined.png"

    if (raw === null || raw === undefined) {
        return sImageHttpPath + folder + defaultFile;
    }

    raw = String(raw);

    if (raw === "" || raw === "undefined" || raw === "null") {
        return sImageHttpPath + folder + defaultFile;
    }

    // 이미 URL('...') 형태로 내려오면 내부만 꺼내기
    // 예: URL('http://...') -> http://...
    var m = raw.match(/^URL\(['"](.+?)['"]\)$/i);
    if (m && m[1]) {
        raw = m[1];
    }

    // 이미 http(s)면 그대로 사용
    if (/^https?:\/\//i.test(raw)) {
        return raw;
    }

    // file:// 로컬 경로는 웹에서 못 읽음 -> 기본 이미지로
    if (/^file:\/\//i.test(raw)) {
        return sImageHttpPath + folder + defaultFile;
    }

    // C:\ 같은 윈도우 로컬 절대경로도 웹에서 못 읽음 -> 기본 이미지로
    if (/^[A-Za-z]:\\/.test(raw) || /^[A-Za-z]:\//.test(raw)) {
        return sImageHttpPath + folder + defaultFile;
    }

    // 이미 folder가 포함된 상대경로면 그대로 붙임
    // 예: profile_image/user_profile_1.png
    if (raw.indexOf(folder) === 0) {
        return sImageHttpPath + raw;
    }

    // 파일명만 오면 folder 붙여서 완성
    return sImageHttpPath + folder + raw;
};


/**************************************************************************
* FORM EVENT 영역
**************************************************************************/
this.ark5020fm_onload = function(obj,e)
{
    // 상세 진입 시 데이터 조회
    this.fn_transaction_callStore();

    // 버튼 권한 처리
    if(objApp.sNowUserRole == "Customer" || objApp.sNowUserRole == ""){
        this.divMain.form.btnPostReview.set_visible(true);
        this.divMain.form.btnReservation.set_visible(true);
    }else{
        this.divMain.form.btnPostReview.set_visible(false);
        this.divMain.form.btnReservation.set_visible(false);
    }
};

/**************************************************************************
* 트랜잭션 호출
**************************************************************************/
this.fn_transaction_callStore = function ()
{
    var sStoreId = objApp.sDetailStoreID;

    this.gfnTransaction(
        "arkGetStoreDetail",
        "ark/GetStoreDetail.do",
        "",
        "dsDStore=out_store dsDMenu=out_store_menu dsReview=dsReview",
        "STORE_ID=" + nexacro.wrapQuote(sStoreId),
        "fnCallback"
    ); 
};

this.fn_transaction_reservation = function ()
{
    this.gfnTransaction(
        "arkSaveReservation",
        "ark/SaveReservation.do",
        "dsReserve=dsReserve",
        "",
        "",
        "fnCallback"
    ); 
};

/**************************************************************************
* CALLBACK
**************************************************************************/
this.fnCallback = function (strSvcId, nErrorCode, strErrorMsg)
{
    if(nErrorCode < 0){
        this.gfnAlert("msg.server.error");
        trace("Transaction Error: " + strSvcId + " / " + strErrorMsg);
        return;
    }

    if (strSvcId === "arkGetStoreDetail")
    {
        /* ----------------------------
           0. 기본 방어
        ---------------------------- */
        if (this.dsDStore.getRowCount() <= 0) {
            trace("dsDStore empty");
            return;
        }

        /* ----------------------------
           1. 매장 대표 이미지
        ---------------------------- */
        var photo = this.dsDStore.getColumn(0, "STORE_PHOTO");
        var imgUrl = this.fnNormalizeImageUrl(photo, "store_photo/", "undefined.png");
        // ImageViewer는 보통 http URL 직접 넣으면 OK
        this.divMain.form.imgStore.set_image(imgUrl);

        /* ----------------------------
           2. 메뉴 대표 이미지
        ---------------------------- */
        if(this.dsDMenu.getRowCount() > 0)
        {
            var menuPhoto = this.dsDMenu.getColumn(0, "MENU_PHOTO");
            // MENU_PHOTO가 store_photo 폴더에 있다고 가정
            var menuUrl = this.fnNormalizeImageUrl(menuPhoto, "store_photo/", "undefined.png");
            this.divMain.form.imgStoreMenu.set_image(menuUrl);
        }
        else
        {
            // 메뉴가 없으면 기본 이미지 처리 (선택)
            this.divMain.form.imgStoreMenu.set_image(
                this.fnNormalizeImageUrl(null, "store_photo/", "undefined.png")
            );
        }

        /* ----------------------------
           3. 리뷰 평균 계산 + 텍스트
        ---------------------------- */
        var rc = this.dsReview.getRowCount();
        sReviewSum = 0;

        for(var i=0; i<rc; i++){
            var r = parseInt(this.dsReview.getColumn(i,"REVIEW_RATING"), 10);
            if (!isNaN(r)) sReviewSum += r;
        }

        if(rc === 0){
            this.divMain.form.staStoreRating.set_text("아직 작성된 리뷰가 없습니다.");
            this.divMain.form.staRating.set_text("-");
        }else{
            var avg = (sReviewSum / rc).toFixed(2);
            this.divMain.form.staStoreRating.set_text(avg + "점 (" + rc + "명)");
            this.divMain.form.staRating.set_text(avg + "점");
        }

        // 제목
        this.divMain.form.staReviewTitle.set_text(
            rc + "건의 " + this.dsDStore.getColumn(0,"STORE_NAME") + " 방문자 평가"
        );

        /* ----------------------------
           4. 리뷰 이미지 & 프로필 정규화 (중요)
           - 서버/DB에서 URL('http://...')로 내려오든
             파일명만 내려오든 여기서 통일
        ---------------------------- */
        for(var i=0; i<rc; i++)
        {
            var reviewImgRaw = this.dsReview.getColumn(i, "REVIEW_IMAGE");
            var profileRaw   = this.dsReview.getColumn(i, "USER_PROFILE");

            // 리뷰 이미지는 store_photo 폴더
            var reviewImgUrl = this.fnNormalizeImageUrl(reviewImgRaw, "store_photo/", "undefined.png");
            this.dsReview.setColumn(i, "REVIEW_IMAGE", reviewImgUrl);

            // 프로필은 profile_image 폴더
            var profileUrl = this.fnNormalizeImageUrl(profileRaw, "profile_image/", "undefined.png");
            this.dsReview.setColumn(i, "USER_PROFILE", profileUrl);
        }

        /* ----------------------------
           5. 전화번호 포맷 변환 (필요 시)
        ---------------------------- */
        this.fnConvertPhoneFormat();

        /* ----------------------------
           6. 카카오맵 로딩
        ---------------------------- */
        this.postStoreKakao(this.webPostKakao);
    }
    else if(strSvcId === "arkSaveReservation")
    {
        this.gfnAlert("msg.register.success");	
    }
};

/**************************************************************************
* 전화번호 변환
* - 8자리면 "XXXX-XXXX"로 처리(가장 흔함)
* - 10~11자리면 휴대폰 형태로 처리하고 싶으면 확장 가능
**************************************************************************/
this.fnConvertPhoneFormat = function()
{
    if (this.dsDStore.getRowCount() <= 0) return;

    for (var i = 0; i < this.dsDStore.getRowCount(); i++)
    {
        var rawPhone = this.dsDStore.getColumn(i, "STORE_PHONE");
        if (!rawPhone) continue;

        rawPhone = String(rawPhone).replace(/[^0-9]/g, "");

        if (rawPhone.length === 8)
        {
            // 예: 12345678 -> 1234-5678
            var formatted = rawPhone.substring(0,4) + "-" + rawPhone.substring(4);
            this.dsDStore.setColumn(i, "STORE_PHONE", formatted);
        }
        else if (rawPhone.length === 9)
        {
            // 예: 021234567 -> 02-123-4567 (선택)
            var formatted9 = rawPhone.substring(0,2) + "-" + rawPhone.substring(2,5) + "-" + rawPhone.substring(5);
            this.dsDStore.setColumn(i, "STORE_PHONE", formatted9);
        }
        else if (rawPhone.length === 10)
        {
            // 예: 0212345678 -> 02-1234-5678 / 0311234567 -> 031-123-4567 (단순 처리)
            var formatted10 = rawPhone.substring(0,3) + "-" + rawPhone.substring(3,6) + "-" + rawPhone.substring(6);
            this.dsDStore.setColumn(i, "STORE_PHONE", formatted10);
        }
        else if (rawPhone.length === 11)
        {
            // 예: 01012345678 -> 010-1234-5678
            var formatted11 = rawPhone.substring(0,3) + "-" + rawPhone.substring(3,7) + "-" + rawPhone.substring(7);
            this.dsDStore.setColumn(i, "STORE_PHONE", formatted11);
        }
    }
};

/**************************************************************************
* 리뷰 팝업
**************************************************************************/
this.divMain_btnPostReview_onclick = function(obj,e)
{
    var CF = new ChildFrame();
    CF.init("reviewPopup", 0,0,600,450,null,null, "Owner::ark5021fm.xfdl");
    CF.set_openalign("center middle");
    CF.showModal(
        this.getOwnerFrame(),
        {param1:this.dsDStore.getColumn(0,"STORE_ID")},
        this,
        "fn_popupCallback"
    ); 	
};

/**************************************************************************
* 예약 팝업
**************************************************************************/
this.divMain_btnReservation_onclick = function(obj,e)
{
    this.dsReserve.addRow();
    this.popupCalender.trackPopupByComponent(obj, 0, obj.height, null, null, "fn_popupCallback");
};

this.fn_popupCallback = function (objId, rtn)
{
    if(!rtn) return;

    if(objId == "popupCalender")
    {
        this.dsReserve.setColumn(0,"RESERVE_NUM",rtn[0]);
        this.dsReserve.setColumn(0,"RESERVE_TIME",rtn[1]);
        this.dsReserve.setColumn(0,"RESERVE_DATE",rtn[2]);
        this.dsReserve.setColumn(0,"STORE_ID", this.dsDStore.getColumn(0,"STORE_ID"));
        this.dsReserve.setColumn(0,"USER_ID", objApp.sNowUserID);

        this.gfnAlert("msg.register","C","popupRegister","fnConfirmCallback");
    }
};

this.fnConfirmCallback = function (strId,strVal)
{
    if(strId == "popupRegister" && strVal == true){
        this.fn_transaction_reservation();
    }
};
]]></Script>
